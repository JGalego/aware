#!/usr/bin/env bash
# aware: lets a Claude Code session see its own usage and change its own model/effort.
#
#   aware launch [--watch] [claude args]   start claude inside tmux with aware wired in (no global install needed);
#                                --watch also opens the live dashboard in a pane beside it
#   aware show [--json]          latest status line (+ advisory), or the raw state as JSON; Claude can run this via Bash too
#   aware watch [--once]         live terminal dashboard: tier, context and plan bars, model/effort, activity
#   aware switch model  <name>   type "/model <name>" into this tmux pane (applies after the current turn)
#   aware switch effort <level>  type "/effort <level>" into this tmux pane
#   aware compact                type "/compact" into this tmux pane (applies after the current turn)
#   aware decide [--prompt TEXT] JSON decision (effort / model / compact); TEXT describes the task (first 300 chars)
#   aware senses [enable|disable NAME | --json]   your own awareness entries (see README: Senses)
#   aware gate [allow [MINUTES] | revoke | status]   the optional subagent gate (AWARE_GATE=1, see below)
#   aware install | uninstall    optional: wire statusline + hooks into ~/.claude/settings.json globally
#   aware statusline | hook | tool-hook | mcp   (internal) called by Claude Code
#
# Tiers (worst signal wins): normal < lean < conserve < critical. Pace = share of a window used /
# share of it elapsed; pace > 1 means that limit runs out before it resets.
#
# Env (all optional):
#   AWARE_LEAN=50        % of 5h/7d limit for tier "lean" (also: any window with pace > 1)
#   AWARE_WARN=80        % of 5h/7d limit for tier "conserve"
#   AWARE_CRIT=95        % of 5h/7d limit for tier "critical"
#   AWARE_CTX_LEAN=50    % of context window for tier "lean"
#   AWARE_CTX_WARN=70    % of context window for tier "conserve" (and the advice to compact)
#   AWARE_SENSES_DIR     folder of sense scripts (default ~/.claude/aware/senses); AWARE_SENSE_TIMEOUT=2 seconds each
#   AWARE_RESET_SOON=15  minutes: a high plan window that resets this soon gets "wait" advice, not a downgrade
#   AWARE_QUIET=1        hook injects only when an advisory fires
#   AWARE_EVERY_TURN=1   hook injects on every prompt (default: only when the tier, model, effort or a 10% band changes)
#   AWARE_ALLOW_COMPACT=0   refuse "aware compact"
#   AWARE_DECIDER_URL=   decision model (POST <url>/v1/systemone); empty = the built-in rules decide
#   AWARE_DECIDER_KEY=   bearer token for a hosted decider (sent as "Authorization: Bearer ...", never logged)
#   AWARE_DECIDER_MODEL= model name for hosted deciders that require one (e.g. jev-latest)
#   AWARE_DECIDER_MODE=dry   dry: only log decisions; advise: the hook advises what the decider says
#   AWARE_DECIDER_MIN_CONF=0.6   below this confidence a field falls back to the rules
#   AWARE_DECIDER_UP_CONF=0.85   confidence needed to advise a costlier model/effort (above tier "normal")
#   AWARE_DECIDER_TIMEOUT=2      seconds before the decider is given up on (rules decide)
#   AWARE_DECIDER_PROMPT=0       1 = also send the latest prompt (first 300 chars) to the decider
#   AWARE_MODELS="haiku sonnet opus"           models switch may select
#   AWARE_EFFORTS="low medium high xhigh max"  effort levels switch may select
#   AWARE_AUTOCONFIRM=1  press Enter on the "Switch model?" dialog for you (only when it names the new model)
#   AWARE_CONFIRM_WAIT=600  seconds the auto-confirm watcher waits for that dialog
#   AWARE_KEEP_DEFAULT=1    restore your default model in settings.json after a switch (0 = leave it)
#   AWARE_ARM=full       experiment arm, for measuring what aware does: full (everything), tiers (readout + tier advice, no tools),
#                        facts (readout only), placebo (an unrelated sentence on the same schedule), off (nothing injected).
#                        Every injection is logged to ~/.claude/aware/injections.log with its size.
#   AWARE_PLACEBO_TEXT=  the sentence used by the placebo arm
#   AWARE_GATE=1         at launch, refuse new Agent/Task/Workflow calls while the tier is critical (any arm);
#                        `aware gate allow [MINUTES]` lifts it for a while (default 30). A speed bump, not a security boundary.
#   AWARE_EFFORT_CACHE=auto  does an effort change keep the prompt cache? auto = only on Fable 5.1+, Opus/Sonnet/Haiku 5.5+ and
#                           not on Bedrock/Vertex/Foundry or a custom ANTHROPIC_BASE_URL; yes/no force the answer
set -u

SELF=$(readlink -f "$0")
HERE=$(dirname "$SELF")
DIR="${AWARE_DIR:-$HOME/.claude/aware}"
LEAN="${AWARE_LEAN:-50}"
WARN="${AWARE_WARN:-80}"
CRIT="${AWARE_CRIT:-95}"
CTX_LEAN="${AWARE_CTX_LEAN:-50}"
CTX_WARN="${AWARE_CTX_WARN:-70}"
RESET_SOON="${AWARE_RESET_SOON:-15}"
# Claude Code keeps the prompt cache across an effort change only on some models and only when talking to
# Anthropic directly (API key or subscription); cloud providers and gateways re-read everything.
ARM="${AWARE_ARM:-full}"
EFFORT_CACHE="${AWARE_EFFORT_CACHE:-auto}"
if [ "$EFFORT_CACHE" = auto ]; then
  if [ -n "${CLAUDE_CODE_USE_BEDROCK:-}${CLAUDE_CODE_USE_VERTEX:-}${CLAUDE_CODE_USE_FOUNDRY:-}" ]; then EFFORT_CACHE=provider
  elif [ -n "${ANTHROPIC_BASE_URL:-}" ] && [[ "${ANTHROPIC_BASE_URL%/}" != https://api.anthropic.com ]]; then EFFORT_CACHE=provider; fi
fi
MODELS="${AWARE_MODELS:-haiku sonnet opus}"
EFFORTS="${AWARE_EFFORTS:-low medium high xhigh max}"
SETTINGS="${AWARE_SETTINGS:-$HOME/.claude/settings.json}"
BIN="${AWARE_BIN:-$HOME/.local/bin/aware}"

command -v jq >/dev/null || { echo "aware needs jq" >&2; exit 1; }

NOW="${AWARE_NOW:-$(date +%s)}"

# with_limits FILE: print the session JSON. 5h/7d limits are account-wide, so until this session has
# its own numbers (before its first response) borrow them from the freshest other session whose
# 5h window has not reset yet; that way the very first prompt, where the goal is set, sees usage too.
with_limits() {
  local g
  if jq -e '.rate_limits' "$1" >/dev/null 2>&1; then cat "$1"; return; fi
  for g in $(ls -t "$DIR"/*.json 2>/dev/null); do
    [ "$g" -ef "$1" ] && continue
    jq -e --argjson now "$NOW" '.rate_limits.five_hour.resets_at > $now' "$g" >/dev/null 2>&1 || continue
    jq -c -s '.[0] + {rate_limits: .[1].rate_limits}' "$1" "$g" && return
  done
  cat "$1"
}

# summarize FILE [lines|sig]
#   lines (default): line 1 status, line 2 (only when tier != normal) "[aware] tier=..." advice.
#   sig: one line the hook compares between prompts (tier, 10% bands, model, effort).
#   state: one JSON object with the numbers, the tier and what the rules would do (input for decide).
summarize() {
  with_limits "$1" | jq -r --arg mode "${2:-lines}" --arg models "$MODELS" --argjson now "$NOW" \
        --argjson lean "$LEAN" --argjson warn "$WARN" --argjson crit "$CRIT" \
        --argjson ctxlean "$CTX_LEAN" --argjson ctxwarn "$CTX_WARN" --argjson soon "$RESET_SOON" --arg effcache "$EFFORT_CACHE" --arg arm "$ARM" '
    def pct:  if . == null then "?" else "\(floor)%" end;
    def day:  strflocaltime("%a %H:%M");
    def dec1: (. * 10 + 0.5 | floor) as $t | "\($t / 10 | floor).\($t % 10)";
    def ktok: if . >= 1000 then "\(. / 1000 | floor)k" else "\(floor)" end;
    # $w = window length in seconds. Pace is only shown once 10% of the window has passed and 5% is used.
    def window($w):
      (.used_percentage) as $u | (.resets_at) as $r
      | (if $u == null or $r == null then null else ($now - ($r - $w)) end) as $el
      | (if $el == null or $el < $w * 0.1 or $u < 5 then null else $u * $w / ($el * 100) end) as $p
      | {u: $u, r: $r, p: $p,
         out: (if $p != null and $p > 1 then $now + (100 - $u) * $el / $u else null end)};
    def wtxt($name):
      "\($name) \(.u | pct)"
      + (if .r == null then "" else
          " (resets \(.r | day)"
          + (if .p == null then "" else ", pace \(.p | dec1)x" end)
          + (if .out == null then "" else ", out ~\(.out | day)" end) + ")" end);

    (.rate_limits.five_hour // {} | window(18000)) as $h5
    | (.rate_limits.seven_day // {} | window(604800)) as $d7
    | (.context_window.used_percentage) as $c
    | ($c // 0) as $c0
    | ([$h5.u, $d7.u] | map(. // 0) | max) as $hi
    | ([$h5.p, $d7.p] | map(. // 0) | max) as $pace
    | (.prompt_cache // {}) as $pc
    | (if $pc.warm == null then null
       elif $pc.warm == true and (($pc.expires_at // ($now + 1)) > $now) then true else false end) as $warm
    | ($pc.recache_tokens_if_cold // .context_window.total_input_tokens) as $recache
    | (if $hi >= $crit then "critical"
       elif $hi >= $warn or $c0 >= $ctxwarn then "conserve"
       elif $hi >= $lean or $c0 >= $ctxlean or $pace > 1 then "lean"
       else "normal" end) as $tier
    | (.model.id // .model.display_name // "?") as $model
    | (.effort.level // "n/a") as $effort
        # Does an effort change keep the prompt cache here? Only on Fable 5.1+ and Opus/Sonnet/Haiku 5.5+ (docs:
        # prompt caching), and not behind Bedrock/Vertex/Foundry or a gateway. Unknown models count as "no".
        | (if $effcache == "yes" then true
           elif $effcache != "auto" then false
           else ([$model | ascii_downcase | capture("(?<f>opus|sonnet|haiku|fable)[- ](?<a>[0-9]+)[-.](?<b>[0-9]+)")] | .[0]) as $v
             | ($v != null) and (($v.a | tonumber) * 100 + ($v.b | tonumber)) >= (if $v.f == "fable" then 501 else 505 end)
           end) as $effkeeps
        | (if $warm == false then "costs nothing extra now: the cache is cold"
           elif $recache == 0 then "costs nothing extra now: nothing is cached yet"
           elif $recache != null then "re-reads ~\($recache | ktok) tokens uncached"
           else "re-reads the whole context uncached" end) as $switchcost
        # Concrete steps (vague advice gets ignored, verified live): name the exact call when the
        # current effort or model is above what the tier calls for.
        | {"low": 0, "medium": 1, "high": 2, "xhigh": 3, "max": 4} as $rank
        | ({"lean": "high", "conserve": "medium", "critical": "low"}[$tier]) as $teff
        | (if $teff == null or ($rank[$effort] // -1) <= $rank[$teff] then null
           elif $effkeeps then "call set_effort \($teff) now (currently \($effort); effort changes keep the cache)"
           else "at the next natural break call set_effort \($teff) (currently \($effort); on this setup an effort change drops the prompt cache and \($switchcost))" end) as $effstep
        # Reset proximity: when every plan window at or above the lean limit resets within $soon minutes,
        # waiting beats downgrading (a switch costs a cache re-read; the limit is about to refill).
        | ([{k: "5h", w: $h5}, {k: "7d", w: $d7}] | map(select((.w.u // 0) >= $lean))) as $hot
        | ($hot | map(select(.w.r != null and .w.r > $now and (.w.r - $now) <= $soon * 60))) as $soonwin
        | (($hot | length) > 0 and ($soonwin | length) == ($hot | length)) as $waiting
        | (if $waiting then ($soonwin | sort_by(.w.r) | .[0]) else null end) as $nearest
        | (if $nearest == null then null
           else "the \($nearest.k) limit (\($nearest.w.u | floor)%) resets in \((($nearest.w.r - $now) / 60) | floor)m, so waiting beats downgrading: finish this step, or tell the user you are pausing until then" end) as $waitnote
        | (if $waiting then null else $effstep end) as $effstep
        # Experiment arms: only "full" has the tools, so only "full" is told to use them; "tiers" and "full" get advice.
        | ($arm == "full") as $act
        | ($arm == "full" or $arm == "tiers") as $advise
        | (if $act then $effstep else null end) as $effstep
        # AWARE_MODELS is ordered cheapest to most expensive. Step down one place from the current model:
        # at conserve only from the most expensive, at critical from anywhere above the cheapest.
        | ($model | ascii_downcase) as $m
        | ($models | split(" ") | map(select(length > 0))) as $ml
        | ($ml | length) as $n
        | ($ml | to_entries | map(select(. as $e | $m | contains($e.value))) | .[0].key) as $idx
        | (if $waiting or $idx == null or $idx == 0 then null
           elif $tier == "critical" or ($tier == "conserve" and $idx == $n - 1) then $ml[$idx - 1] else null end) as $tmodel
        # Delegation: the cheapest model for mechanical work, the next one up where judgment is needed.
        | ("delegate bulk work to cheaper-model subagents (\($ml[0] // "haiku") for search, reads, summaries"
           + (if $n > 2 then "; \($ml[1]) when judgment is needed" else "" end) + ")") as $deleg
    | def band: if . == null then "?" else . / 10 | floor | tostring end;
      if $mode == "sig" then
        # empty = nothing measured yet (Claude Code runs the statusline before the first response)
        if $h5.u == null and $d7.u == null and $c == null then ""
        else "\($tier)|\($h5.u | band)|\($d7.u | band)|\($c | band)|\($model)|\($effort)" end
      elif $mode == "state" then
        # Everything a decider needs, plus what the rules would do (the fallback).
        {tier: $tier,
         h5: {u: $h5.u, p: $h5.p}, d7: {u: $d7.u, p: $d7.p},
         ctx: $c, ctx_tokens: .context_window.total_input_tokens,
         model: $model, effort: $effort, warm: $warm, recache: $recache, effkeeps: $effkeeps,
         models: $ml, deleg: $deleg,
         limits: {lean: $lean, warn: $warn, crit: $crit, ctx_lean: $ctxlean, ctx_warn: $ctxwarn},
         rules: {effort: (if $effstep != null then $teff else null end),
                 model: $tmodel,
                 compact: (($tier == "conserve" or $tier == "critical") and $c0 >= $ctxwarn)}}
        | tojson
      else
        ([ (if ($h5.u // 0) >= $lean then "5h \($h5.u | pct)" else empty end),
           (if ($d7.u // 0) >= $lean then "7d \($d7.u | pct)" else empty end),
           (if ($h5.p // 0) > 1 then "5h pace \($h5.p | dec1)x, out ~\($h5.out | day)" else empty end),
           (if ($d7.p // 0) > 1 then "7d pace \($d7.p | dec1)x, out ~\($d7.out | day)" else empty end),
           (if $c0 >= $ctxlean or $c0 >= $ctxwarn then "ctx \($c | pct)" else empty end) ] | join("; ")) as $why
        | (if $tmodel == null or ($act | not) then null
           else "at the next natural break call set_model \($tmodel) (a switch \($switchcost))" end) as $modstep
        | (if $tier == "lean" then
             [$waitnote, $effstep, $deleg, "keep replies and tool output short"]
           elif $tier == "conserve" then
             [$waitnote, $effstep, $deleg, $modstep,
              (if $c0 >= $ctxwarn and $act then "call compact at the next natural break" else null end)]
           else
             ["finish the current step, write a short state summary, and ask the user before starting anything new", $waitnote, $effstep, $modstep]
           end | map(select(. != null)) | join("; ")) as $advice
        | (if $act and ($tier == "conserve" or $tier == "critical") then
             " Without the aware tools, tell the user the command instead (e.g. /effort medium, /model sonnet, /compact)."
           else "" end) as $fallback
        | "[usage] \($h5 | wtxt("5h")) | \($d7 | wtxt("7d")) | ctx \($c | pct) | \(.model.display_name // .model.id // "?") | effort \($effort)"
          + (if $warm == true then " | cache warm" elif $warm == false then " | cache cold" else "" end)
          + " | $\((.cost.total_cost_usd // 0) * 100 | floor / 100)",
          (if $lean != 50 or $warn != 80 or $crit != 95 or $ctxlean != 50 or $ctxwarn != 70
           then " The user set custom limits (plan \($lean)/\($warn)/\($crit)%, context \($ctxlean)/\($ctxwarn)%), so the tier is right even if the numbers look low: follow it." else "" end) as $custom
        | (if $tier == "normal" or ($advise | not) then empty else "[aware] tier=\($tier)\(if $why == "" then "" else " (\($why))" end): \($advice).\($fallback)\($custom)" end)
      end
  ' 2>/dev/null
}

# decide FILE [PROMPT]: print one JSON decision {source, tier, effort, model, compact, ...}.
# effort/model are target values (null = leave as is), compact is a boolean. With AWARE_DECIDER_URL set
# the decision model is asked three typed questions (POST /v1/systemone: choice, choice, noul) and its
# answers are used where confident; anything else (no URL, timeout, bad answer, low confidence) falls
# back to the rules. Step ups need more confidence than step downs.
decide() {
  local st req resp err rc
  st=$(summarize "$1" state) && [ -n "$st" ] || return 1
  if [ -z "${AWARE_DECIDER_URL:-}" ]; then
    jq -c '{source: "rules", tier, effort: .rules.effort, model: .rules.model, compact: .rules.compact}' <<<"$st"
    return
  fi
  req=$(jq -c --arg efforts "$EFFORTS" --arg prompt "${2:-}" --arg model "${AWARE_DECIDER_MODEL:-}" '
    def pct: if . == null then "unknown" else "\(floor)%" end;
    def desc: {"low": "routine or mechanical steps", "medium": "typical work", "high": "hard reasoning or design decisions",
               "xhigh": "very hard problems", "max": "only the very hardest problems",
               "haiku": "cheapest; mechanical work", "sonnet": "balanced; most work", "opus": "most capable and most expensive; hardest reasoning"};
    (if $model != "" then {model: $model} else {} end) + {state: ("Claude Code session. Plan usage: 5h \(.h5.u | pct)\(if .h5.p then " (pace \(.h5.p * 10 | floor / 10)x)" else "" end), 7d \(.d7.u | pct)\(if .d7.p then " (pace \(.d7.p * 10 | floor / 10)x)" else "" end). "
              + "Context window \(.ctx | pct) full\(if .ctx_tokens then " (\(.ctx_tokens) tokens)" else "" end). Current model \(.model), effort \(.effort). "
              + "Prompt cache \(if .warm == true then "warm" elif .warm == false then "cold" else "unknown" end). Usage tier: \(.tier)."
              + (if $prompt != "" then " Latest user request: \($prompt)" else "" end)),
     questions: {
       effort: {type: "choice", instructions: "Which effort level should the assistant use for its next steps? Plan limits are finite, so prefer the lowest level that still does the job well.",
                criteria: ($efforts | split(" ") | map(select(length > 0)) | map({key: ., value: (desc[.] // .)}) | from_entries)},
       model: {type: "choice", instructions: "Which model should the session use for its next steps? Switching drops the prompt cache, so only change it when it clearly pays off.",
              criteria: (.models | map({key: ., value: (desc[.] // .)}) | from_entries)},
       compact: {type: "noul", instructions: "Should the conversation be compacted at the next natural break, given how full the context window is?"}}}' <<<"$st")
  # The key goes through a private 0600 header file (curl -H @file), so it never shows up in `ps`.
  local hdr="" auth=()
  if [ -n "${AWARE_DECIDER_KEY:-}" ]; then
    mkdir -p "$DIR"; hdr=$(umask 077; mktemp "$DIR/.hdr.XXXXXX")
    printf 'Authorization: Bearer %s\n' "$AWARE_DECIDER_KEY" > "$hdr"; auth=(-H "@$hdr")
  fi
  resp=$(curl -fsS --max-time "${AWARE_DECIDER_TIMEOUT:-2}" -H 'Content-Type: application/json' ${auth[@]+"${auth[@]}"} -d "$req" \
           "${AWARE_DECIDER_URL%/}/v1/systemone" 2>&1); rc=$?
  [ -z "$hdr" ] || rm -f "$hdr"
  [ $rc -eq 0 ] || {
    err=$(printf '%s' "$resp" | tr '\n' ' ' | cut -c1-160)
    jq -c --arg e "decider unreachable: $err" '{source: "rules", error: $e, tier, effort: .rules.effort, model: .rules.model, compact: .rules.compact}' <<<"$st"
    return
  }
  jq -c --slurpfile st <(printf '%s' "$st") --arg efforts "$EFFORTS" \
        --argjson min "${AWARE_DECIDER_MIN_CONF:-0.6}" --argjson up "${AWARE_DECIDER_UP_CONF:-0.85}" '
    $st[0] as $s
    # Stepping up costs plan usage, so it needs more confidence under pressure; at the normal tier
    # a justified step up is exactly what the decider is for, so the usual threshold applies.
    | (if $s.tier == "normal" then $min else $up end) as $upc
    | ($efforts | split(" ") | map(select(length > 0))) as $el
    | def pick($id; $list; $cur; $fallback):
        (.answers[$id] // {}) as $a
        | ($a.choice // $a.answer // $a.value) as $c
        | ($a.confidence // ($a.probabilities | if type == "object" then (map(.) | max) else null end)) as $p
        | ($list | index($c)) as $ci
        | ($list | index($cur)) as $cur_i
        | if $c == null or $p == null or $ci == null or $p < $min then {v: $fallback, p: $p, c: $c}
          elif $c == $cur then {v: null, p: $p, c: $c}
          elif ($cur_i != null and $ci > $cur_i and $p < $upc) then {v: null, p: $p, c: $c}
          else {v: $c, p: $p, c: $c} end;
    pick("effort"; $el; $s.effort; $s.rules.effort) as $e
    | pick("model"; $s.models; ($s.model | ascii_downcase | . as $m | $s.models | map(select(. as $x | $m | contains($x))) | .[0]); $s.rules.model) as $m
    | ((.answers.compact // null) | if type == "object" then (.noul // .probability // .p) else . end) as $cp
    | {source: "decider", tier: $s.tier, effort: $e.v, model: $m.v,
       compact: (if ($cp | type) != "number" then $s.rules.compact elif $cp >= $min then true elif $cp <= (1 - $min) then false else $s.rules.compact end),
       p: {effort: $e.p, model: $m.p, compact: $cp}, said: {effort: $e.c, model: $m.c}, rules: $s.rules}' <<<"$resp" 2>/dev/null \
    || jq -c '{source: "rules", error: "decider answer not understood", tier, effort: .rules.effort, model: .rules.model, compact: .rules.compact}' <<<"$st"
}

# keep_default KIND JQ-OBJECT: snapshot the settings.json keys a slash command is about to overwrite
# (e.g. '{model}'), wait for them to change, then put the old values back (null = key was absent).
# Slash commands only run once the current turn ends, so the watcher waits up to 15 minutes.
keep_default() {
  local pidf="$DIR/restore-$1.pid" prev
  mkdir -p "$DIR"
  if [ -f "$pidf" ]; then kill "$(cat "$pidf")" 2>/dev/null; rm -f "$pidf"; fi   # a newer switch supersedes a pending restore
  { [ "${AWARE_KEEP_DEFAULT:-1}" = 1 ] && [ -f "$SETTINGS" ]; } || return 0
  prev=$(jq -c "$2" "$SETTINGS" 2>/dev/null) || return 0
  ( for _ in $(seq 1 900); do
      sleep 1
      [ -f "$SETTINGS" ] || break
      cur=$(jq -c "$2" "$SETTINGS" 2>/dev/null) || continue
      [ "$cur" = "$prev" ] && continue
      jq --argjson p "$prev" 'reduce ($p | to_entries[]) as $e (.; if $e.value == null then del(.[$e.key]) else .[$e.key] = $e.value end)' \
        "$SETTINGS" > "$SETTINGS.aware.tmp" && mv "$SETTINGS.aware.tmp" "$SETTINGS"
      break
    done ) >/dev/null 2>&1 &
  echo $! > "$pidf"
}

# Type a slash command into this session's pane and log it.
type_cmd() {
  tmux send-keys -t "$TMUX_PANE" -l "$1" || return 4
  sleep 0.2
  tmux send-keys -t "$TMUX_PANE" Enter || return 4
  mkdir -p "$DIR"; printf '%s %s pane=%s\n' "$(date -Is)" "$1" "$TMUX_PANE" >> "$DIR/switches.log"
}

latest() { ls -t "$DIR"/*.json 2>/dev/null | head -1; }
panefile() { local p="${AWARE_WATCH_PANE:-${TMUX_PANE:-}}"; [ -n "$p" ] && printf '%s/pane-%s.json' "$DIR" "${p#%}"; }

allowed_has() { local w; for w in $1; do [ "$w" = "$2" ] && return 0; done; return 1; }

# usage_hook FILE SID INPUT: the usage readout and tier advice, only when something meaningful changed
usage_hook() {
  local f=$1 sid=$2 in=$3 sig st out prompt d adv
  # Hook output stays in the history, so only speak when something meaningful changed
  # (tier, a 10% band, model, effort). Critical repeats every prompt.
  [ "$ARM" = off ] && return 0
  sig=$(summarize "$f" sig); st="$DIR/$sid.hook"
  [ -n "$sig" ] || return 0
  if [ "${AWARE_EVERY_TURN:-0}" != 1 ] && [ "${sig%%|*}" != critical ] \
     && [ -f "$st" ] && [ "$(cat "$st")" = "$sig" ]; then return 0; fi
  printf '%s' "$sig" > "$st"
  out=$(summarize "$f")
  # placebo arm: same schedule as the real readout, but an unrelated sentence of similar length
  [ "$ARM" = placebo ] && out="[note] ${AWARE_PLACEBO_TEXT:-Keep commit messages short and follow the naming style the repository already uses. Mention the files you changed in your final summary.}"
  if [ "$ARM" = full ] && [ -n "${AWARE_DECIDER_URL:-}" ]; then
    prompt=""; [ "${AWARE_DECIDER_PROMPT:-0}" = 1 ] && prompt=$(printf '%s' "$in" | jq -r '(.prompt // "")[0:300]')
    d=$(decide "$f" "$prompt") && {
      mkdir -p "$DIR"
      jq -c --arg ts "$(date -Is)" --arg sid "$sid" --arg sig "$sig" --arg mode "${AWARE_DECIDER_MODE:-dry}" \
        '{ts: $ts, sid: $sid, sig: $sig, mode: $mode} + .' <<<"$d" >> "$DIR/decisions.log"
      if [ "${AWARE_DECIDER_MODE:-dry}" = advise ]; then
        # the decider replaces the rules' concrete steps; the generic delegation advice stays
        adv=$(jq -rn --argjson d "$d" --argjson s "$(summarize "$f" state)" '
          ([ (if $d.effort then (if $s.effkeeps then "call set_effort \($d.effort) now" else "at the next natural break call set_effort \($d.effort) (on this setup it drops the prompt cache)" end) else empty end),
             (if $d.model then "at the next natural break call set_model \($d.model)" else empty end),
             (if $d.compact then "call compact at the next natural break" else empty end),
             (if $s.tier != "normal" then $s.deleg else empty end) ] | join("; ")) as $steps
          | if $d.source != "decider" or $steps == "" then empty
            else "[aware] tier=\($d.tier) (decider): \($steps)." end')
        [ -n "$adv" ] && out="$(printf '%s\n' "$out" | sed -n 1p)"$'\n'"$adv"
      fi
    }
  fi
  if [ "${AWARE_QUIET:-0}" = 1 ] && [ "$ARM" != placebo ]; then out=$(printf '%s\n' "$out" | sed -n '2,$p'); fi
  [ -n "$out" ] || return 0
  log_injection "$sid" "$out"
  printf '%s\n' "$out"
}

# log_injection SID TEXT: one JSON line per injection, so what aware costs in context can be measured
log_injection() {
  mkdir -p "$DIR"
  jq -cn --arg ts "$(date -Is)" --arg sid "$1" --arg arm "$ARM" --arg t "$2" '{ts: $ts, sid: $sid, arm: $arm, chars: ($t | length)}' >> "$DIR/injections.log"
}

# gate_allowed: true while the user has lifted the gate and the allowance has not expired
gate_allowed() {
  local until; until=$(cat "$DIR/gate.allow" 2>/dev/null) || return 1
  [[ "$until" =~ ^[0-9]+$ ]] && [ "$until" -gt "$NOW" ]
}

case "${1:-}" in
  statusline)
    mkdir -p "$DIR"
    in=$(cat)
    sid=$(printf '%s' "$in" | jq -r '.session_id // "unknown"')
    printf '%s' "$in" > "$DIR/$sid.json.tmp" && mv "$DIR/$sid.json.tmp" "$DIR/$sid.json"
    pf=$(panefile) && printf '%s' "$in" > "$pf"
    # cost history, one line per change: the hook compares cost per turn before/after aware's own moves
    hist="$DIR/$sid.hist"
    cost=$(printf '%s' "$in" | jq -r '.cost.total_cost_usd // 0')
    misses=$(printf '%s' "$in" | jq -r '.prompt_cache.misses // 0')
    [ "$(tail -n 1 "$hist" 2>/dev/null | cut -d' ' -f2)" = "$cost" ] || printf '%s %s %s\n' "$NOW" "$cost" "$misses" >> "$hist"
    [ "$(wc -l < "$hist")" -gt 400 ] && { tail -n 200 "$hist" > "$hist.tmp" && mv "$hist.tmp" "$hist"; }
    summarize "$DIR/$sid.json" | head -1
    ;;
  hook)
    in=$(cat)
    sid=$(printf '%s' "$in" | jq -r '.session_id // empty')
    f="$DIR/$sid.json"; [ -f "$f" ] || exit 0   # nothing yet (before first API response)
    out=$(usage_hook "$f" "$sid" "$in")
    extra=""; [ "$ARM" = full ] && extra=$(AWARE_FILE="$f" python3 -I "$HERE/aware_senses.py" hook-extra "$sid" 2>/dev/null)
    if [ -n "$extra" ]; then out="${out:+$out$'\n'}$extra"; log_injection "$sid" "$extra"; fi
    [ -n "$out" ] && printf '%s\n' "$out"
    ;;
  tool-hook)
    [ "$ARM" = full ] || exit 0
    exec python3 -I "$HERE/aware_senses.py" tool-hook
    ;;
  gate-hook)
    # PreToolUse: while the tier is critical, refuse new subagents/workflows (fan-out is where the plan burns fastest).
    in=$(cat)
    [ "${AWARE_GATE:-0}" = 1 ] || exit 0
    tool=$(printf '%s' "$in" | jq -r '.tool_name // empty')
    case "$tool" in Agent|Task|Workflow) ;; *) exit 0 ;; esac
    sid=$(printf '%s' "$in" | jq -r '.session_id // empty')
    f="$DIR/$sid.json"; [ -f "$f" ] || exit 0
    gate_allowed && exit 0
    st=$(summarize "$f" state) || exit 0
    [ "$(jq -r '.tier' <<<"$st")" = critical ] || exit 0
    why=$(jq -r '([{k:"5h",u:.h5.u},{k:"7d",u:.d7.u}] | map(select(.u != null)) | max_by(.u) | "\(.k) \(.u | floor)%") // "plan usage"' <<<"$st")
    printf '%s %s pane=%s %s\n' "$(date -Is)" gate "${TMUX_PANE:--}" "refused $tool at $why" >> "$DIR/events.log"
    jq -cn --arg r "aware: plan usage is critical ($why of the limit), so new subagents and workflows are paused. Finish this step in the main session without fanning out, summarize where things stand, and ask the user before starting more. The user can lift this with 'aware gate allow'; do not run that yourself." \
      '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
    ;;
  gate)
    case "${2:-status}" in
      allow)  m="${3:-30}"; [[ "$m" =~ ^[0-9]+$ ]] || { echo "usage: aware gate allow [MINUTES]" >&2; exit 1; }
              mkdir -p "$DIR"; echo $((NOW + m * 60)) > "$DIR/gate.allow"; echo "gate lifted for $m minutes" ;;
      revoke) rm -f "$DIR/gate.allow"; echo "gate back on" ;;
      status) if gate_allowed; then echo "lifted until $(date -d "@$(cat "$DIR/gate.allow")" +%H:%M)"; else echo "on (when AWARE_GATE=1 at launch)"; fi ;;
      *) echo "usage: aware gate [allow [MINUTES] | revoke | status]" >&2; exit 1 ;;
    esac
    ;;
  show)
    f=$(panefile); { [ -n "$f" ] && [ -f "$f" ]; } || f=$(latest)
    [ -n "$f" ] || { echo "no data yet (the statusline writes it after the first response; start with 'aware launch')" >&2; exit 1; }
    if [ "${2:-}" = --json ]; then summarize "$f" state; else
      summarize "$f"
      [ -d "${AWARE_SENSES_DIR:-$DIR/senses}" ] && AWARE_FILE="$f" python3 -I "$HERE/aware_senses.py" list --json 2>/dev/null \
        | jq -r '.[] | select((.level // "ok") != "ok") | "[aware] sense \(.name) (\(.level)): \(.reading)\(if (.advice // "") != "" then ". " + .advice else "" end)"'
    fi
    ;;
  senses)
    case "${2:-list}" in
      enable|disable) exec python3 -I "$HERE/aware_senses.py" "$2" "${3:-}" ;;
      *)
        [ "${2:-}" = list ] && shift
        f=$(panefile); { [ -n "$f" ] && [ -f "$f" ]; } || f=$(latest)
        export AWARE_FILE="$f" AWARE_SESSION_ID="$([ -n "$f" ] && jq -r '.session_id // empty' "$f" 2>/dev/null)"
        exec python3 -I "$HERE/aware_senses.py" list "${@:2}" ;;
    esac
    ;;
  watch)
    exec python3 -I "$HERE/aware_watch.py" "$SELF" "${@:2}"
    ;;
  decide)
    prompt=""; shift
    if [ "${1:-}" = --prompt ]; then prompt="${2:0:300}"; shift 2; fi   # what the task is (sent to the decider)
    f="${1:-}"; [ -n "$f" ] || { f=$(panefile); { [ -n "$f" ] && [ -f "$f" ]; } || f=$(latest); }
    [ -n "$f" ] || { echo "no data yet (start with 'aware launch')" >&2; exit 1; }
    decide "$f" "$prompt" || { echo "nothing measured yet" >&2; exit 1; }
    ;;
  switch)
    kind="${2:-}"; val="${3:-}"
    case "$kind" in
      model)  allowed="$MODELS";  cmd="/model $val" ;;
      effort) allowed="$EFFORTS"; cmd="/effort $val" ;;
      *) echo "usage: aware switch model|effort <value>" >&2; exit 1 ;;
    esac
    # Strict allowlist: this value is typed into a terminal, so nothing else gets through.
    allowed_has "$allowed" "$val" || { echo "refused: '$val' is not one of: $allowed" >&2; exit 2; }
    [ -n "${TMUX_PANE:-}" ] || { echo "not inside tmux (start with 'aware launch'); ask the user to run: $cmd" >&2; exit 3; }
    # /model writes .model and /effort writes .modelSettings[<model>].effortLevel (older versions:
    # .effortLevel) as the user's default in settings.json (verified live, 2.1.328). Undo that.
    if [ "$kind" = model ]; then
      [ "$(jq -c '.model // null' "$SETTINGS" 2>/dev/null)" = "\"$val\"" ] || keep_default model '{model}'
    else
      keep_default effort '{modelSettings, effortLevel}'
    fi
    type_cmd "$cmd" || exit 4
    # Opt-in: confirm the "Switch model?" dialog ourselves. Enter is only sent once a dialog naming THIS
    # model is on screen (never blindly), and the watcher gives up after AWARE_CONFIRM_WAIT seconds.
    auto=0
    if [ "$kind" = model ] && [ "${AWARE_AUTOCONFIRM:-0}" = 1 ]; then
      auto=1
      [ -f "$DIR/confirm.pid" ] && kill "$(cat "$DIR/confirm.pid")" 2>/dev/null
      pane="$TMUX_PANE"
      ( for _ in $(seq 1 "${AWARE_CONFIRM_WAIT:-600}"); do
          sleep 1
          scr=$(tmux capture-pane -p -t "$pane" 2>/dev/null) || break
          if grep -qi 'Switch model?' <<<"$scr" && grep -qiE "Yes, switch to $val" <<<"$scr"; then
            tmux send-keys -t "$pane" Enter
            printf '%s autoconfirmed /model %s pane=%s\n' "$(date -Is)" "$val" "$pane" >> "$DIR/switches.log"
            break
          fi
        done ) >/dev/null 2>&1 &
      echo $! > "$DIR/confirm.pid"
    fi
    if [ "$kind" = model ] && [ "$auto" = 1 ]; then
      echo "typed '$cmd'. After this turn Claude Code shows a 'Switch model?' dialog (the prompt cache is dropped, so the next reply re-reads the whole history); aware will confirm it automatically. Your default model in settings.json is left unchanged."
    elif [ "$kind" = model ]; then
      echo "typed '$cmd'. After this turn Claude Code shows a 'Switch model?' dialog (the prompt cache is dropped, so the next reply re-reads the whole history and costs more); the USER must confirm it with Enter. Your default model in settings.json is left unchanged."
    else
      ef=$(f=$(panefile); { [ -n "$f" ] && [ -f "$f" ]; } || f=$(latest); [ -n "$f" ] && summarize "$f" state | jq -r '.effkeeps // false')
      if [ "$ef" = true ]; then ecache="it keeps the prompt cache"
      else ecache="on this setup it may drop the prompt cache (the next reply re-reads the history)"; fi
      echo "typed '$cmd'; it takes effect once the current turn ends and $ecache. Your default effort in settings.json is left unchanged."
    fi
    ;;
  compact)
    # No arguments on purpose: nothing but the literal "/compact" is ever typed.
    [ "${AWARE_ALLOW_COMPACT:-1}" = 1 ] || { echo "refused: compact is disabled (AWARE_ALLOW_COMPACT=0)" >&2; exit 2; }
    [ -n "${TMUX_PANE:-}" ] || { echo "not inside tmux (start with 'aware launch'); ask the user to run: /compact" >&2; exit 3; }
    type_cmd "/compact" || exit 4
    echo "typed '/compact'; it runs once the current turn ends and replaces the history with a summary. Put anything that must survive (goal, next steps, key file paths) in this reply. A model switch right after compacting is cheap."
    ;;
  launch)
    shift
    watch=0; if [ "${1:-}" = --watch ]; then watch=1; shift; fi
    command -v tmux >/dev/null || { echo "aware launch needs tmux" >&2; exit 1; }
    case "$ARM" in full|tiers|facts|placebo|off) ;; *) echo "aware: AWARE_ARM must be full, tiers, facts, placebo or off (got '$ARM')" >&2; exit 1 ;; esac
    settings=$(jq -cn --arg bin "$SELF" --arg gate "${AWARE_GATE:-0}" '{statusLine:{type:"command",command:"\($bin) statusline"},hooks:{UserPromptSubmit:[{hooks:[{type:"command",command:"\($bin) hook"}]}],PostToolUse:[{hooks:[{type:"command",command:"\($bin) tool-hook"}]}]}}
      | if $gate == "1" then .hooks.PreToolUse = [{matcher:"Agent|Task|Workflow",hooks:[{type:"command",command:"\($bin) gate-hook"}]}] else . end')
    # alwaysLoad: keep aware's tools in the prompt instead of deferred behind tool search; deferred,
    # Claude ignored even an explicit "call set_effort medium now" advisory (verified live, 2.1.329).
    # Only the "full" arm has the tools (and the policy sent with them); the other arms are readout/advice only.
    mcp=$(jq -cn --arg bin "$SELF" --arg arm "$ARM" '{mcpServers: (if $arm == "full" then {aware:{command:$bin,args:["mcp"],alwaysLoad:true}} else {} end)}')
    # AWARE_DECIDER_KEY is deliberately not forwarded as an `env VAR=value` argument (that would show up in
    # `ps`); it is inherited through the environment instead.
    fwd=(); for v in $(compgen -e | grep '^AWARE_' | grep -v '^AWARE_DECIDER_KEY$'); do fwd+=("$v=${!v}"); done
    cmd=(env ${fwd[@]+"${fwd[@]}"} claude --settings "$settings" --mcp-config "$mcp" "$@")
    # --watch: put the live dashboard (aware watch) in a pane next to Claude, tracking that pane's session.
    wcmd() { printf '%q ' env ${fwd[@]+"${fwd[@]}"} "AWARE_WATCH_PANE=$1" "$SELF" watch; }
    if [ -n "${TMUX:-}" ]; then
      [ "$watch" = 1 ] && tmux split-window -d -h -l 40% "$(wcmd "$TMUX_PANE")"
      exec "${cmd[@]}"
    fi
    if [ "$watch" = 1 ]; then
      tmux new-session -d -s "aware-$$" -- "${cmd[@]}" || exit 1
      pane=$(tmux display-message -p -t "aware-$$" '#{pane_id}')
      tmux split-window -d -h -l 40% -t "$pane" "$(wcmd "$pane")"
      exec tmux attach -t "aware-$$"
    fi
    exec tmux new-session -s "aware-$$" -- "${cmd[@]}"
    ;;
  mcp)
    exec python3 -I "$HERE/aware_mcp.py" "$SELF"
    ;;
  install)
    mkdir -p "$(dirname "$BIN")" "$(dirname "$SETTINGS")"
    ln -sf "$SELF" "$BIN"
    [ -f "$SETTINGS" ] || echo '{}' > "$SETTINGS"
    cp "$SETTINGS" "$SETTINGS.aware-backup"
    existing=$(jq -r '.statusLine.command // empty' "$SETTINGS")
    if [ -n "$existing" ] && [ "$existing" != "$BIN statusline" ]; then
      echo "A different statusLine is already set ($existing); leaving it alone." >&2
      keep=1
    else keep=0; fi
    jq --arg bin "$BIN" --argjson keep "$keep" '
      (if $keep == 0 then .statusLine = {type:"command", command:"\($bin) statusline"} else . end)
      | .hooks.UserPromptSubmit = ([(.hooks.UserPromptSubmit // [])[] | select((.hooks[0].command // "") | endswith("aware hook") | not)]
                                   + [{hooks:[{type:"command", command:"\($bin) hook"}]}])
      | .hooks.PostToolUse = ([(.hooks.PostToolUse // [])[] | select((.hooks[0].command // "") | endswith("aware tool-hook") | not)]
                              + [{hooks:[{type:"command", command:"\($bin) tool-hook"}]}])
    ' "$SETTINGS" > "$SETTINGS.tmp" && mv "$SETTINGS.tmp" "$SETTINGS" || { rm -f "$SETTINGS.tmp"; echo "install failed; settings untouched" >&2; exit 1; }
    echo "Installed globally. Backup: $SETTINGS.aware-backup. (switch/MCP tools still need 'aware launch'.)"
    ;;
  uninstall)
    [ -f "$SETTINGS" ] || exit 0
    cp "$SETTINGS" "$SETTINGS.aware-backup"
    jq '
      (if ((.statusLine.command // "") | endswith("aware statusline")) then del(.statusLine) else . end)
      | (if .hooks.UserPromptSubmit then .hooks.UserPromptSubmit |= map(select((.hooks[0].command // "") | endswith("aware hook") | not)) else . end)
      | (if .hooks.PostToolUse then .hooks.PostToolUse |= map(select((.hooks[0].command // "") | endswith("aware tool-hook") | not)) else . end)
      | (if .hooks.UserPromptSubmit == [] then del(.hooks.UserPromptSubmit) else . end)
      | (if .hooks.PostToolUse == [] then del(.hooks.PostToolUse) else . end)
      | (if .hooks == {} then del(.hooks) else . end)
    ' "$SETTINGS" > "$SETTINGS.tmp" && mv "$SETTINGS.tmp" "$SETTINGS" || { rm -f "$SETTINGS.tmp"; echo "uninstall failed; settings untouched" >&2; exit 1; }
    echo "Removed from $SETTINGS (backup: $SETTINGS.aware-backup)."
    ;;
  *)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF"; exit 1 ;;
esac
